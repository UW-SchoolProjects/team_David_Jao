#!/usr/bin/env bash
# Wrapper to run cutechess-cli with the AppImage-bundled Qt libraries.
set -euo pipefail

# Resolve script directory robustly (handles symlinks)
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BIN="$ROOT/squashfs-root/usr/bin/cutechess-cli"
LIB1="$ROOT/squashfs-root/usr/lib"
LIB2="$ROOT/squashfs-root/usr/lib/x86_64-linux-gnu"

if [[ ! -x "$BIN" ]]; then
  echo "Error: cutechess-cli binary not found at $BIN" >&2
  exit 1
fi
# Some AppImage builds only ship usr/lib; tolerate missing usr/lib/x86_64-linux-gnu.
if [[ ! -d "$LIB1" ]]; then
  echo "Error: Qt library dir not found: $LIB1" >&2
  exit 1
fi

# Build a local LD_LIBRARY_PATH without polluting the environment
NEW_LD_PATH="$LIB1"
if [[ -d "$LIB2" ]]; then
  NEW_LD_PATH="$LIB1:$LIB2"
fi
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
  case ":$LD_LIBRARY_PATH:" in *":$LIB1:"*) : ;; *) NEW_LD_PATH="$NEW_LD_PATH:$LD_LIBRARY_PATH" ;; esac
  case ":$LD_LIBRARY_PATH:" in *":$LIB2:"*) : ;; *) : ;; esac
fi

exec env LD_LIBRARY_PATH="$NEW_LD_PATH" "$BIN" "$@"
