#!/usr/bin/env bash
# Wrapper to run cutechess-cli with the AppImage-bundled Qt libraries.
set -euo pipefail

# Resolve script directory robustly (handles symlinks)
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

BIN="$ROOT/squashfs-root/usr/bin/cutechess-cli"

if [[ ! -x "$BIN" ]]; then
  # Fall back to a system cutechess-cli if available (avoid recursion)
  # Drop this script's directory from PATH before searching.
  PATH_FALLBACK="$PATH"
  case "$PATH_FALLBACK" in
    "$SCRIPT_DIR:"*) PATH_FALLBACK="${PATH_FALLBACK#${SCRIPT_DIR}:}" ;;
    *":$SCRIPT_DIR") PATH_FALLBACK="${PATH_FALLBACK%:${SCRIPT_DIR}}" ;;
  esac
  alt_path=$(PATH="$PATH_FALLBACK" command -v cutechess-cli || true)
  if [[ -n "$alt_path" ]]; then
    exec "$alt_path" "$@"
  fi
  echo "Error: cutechess-cli binary not found at $BIN" >&2
  exit 1
fi

# Try to locate a Qt6 core library inside the extracted AppImage.
QT_CORE_LIB=$(find "$ROOT/squashfs-root" -maxdepth 8 -type f -name 'libQt6Core.so*' 2>/dev/null | head -n 1 || true)

if [[ -z "${QT_CORE_LIB:-}" ]]; then
  echo "Warning: Could not find libQt6Core.so* under $ROOT/squashfs-root; running without custom LD_LIBRARY_PATH." >&2
  exec "$BIN" "$@"
fi

QT_LIB_DIR="$(dirname "$QT_CORE_LIB")"

# Build a new LD_LIBRARY_PATH that prefers the AppImage libs.
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
  export LD_LIBRARY_PATH="$QT_LIB_DIR:$LD_LIBRARY_PATH"
else
  export LD_LIBRARY_PATH="$QT_LIB_DIR"
fi

exec "$BIN" "$@"
